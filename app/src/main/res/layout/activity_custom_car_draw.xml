<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Left: Drawing Canvas -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✏️ DRAW YOUR CUSTOM CAR SHAPE (자동차 형상 그리기)"
            android:textColor="@color/neon_blue"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Touch &amp; Drag finger across canvas to draw your custom 3D EV body silhouette!"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@color/card_bg">

            <com.openworld.racer.ui.CustomCarDrawView
                android:id="@+id/carDrawCanvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <!-- Right: Presets & Action Buttons -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_weight="0.8"
        android:background="@color/card_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎨 Shape Presets"
            android:textColor="@color/neon_yellow"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPresetSupercar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/card_stroke"
            android:text="🏎️ Supercar Silhouette"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnPresetCyber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/card_stroke"
            android:text="📐 Cyber Truck Angle"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnPresetSuv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/card_stroke"
            android:text="🚙 SUV Box Profile"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnPresetFormula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/card_stroke"
            android:text="⚡ Formula F1 Low Aero"
            android:textColor="@color/white" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnSaveCustomCar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="@color/neon_blue"
            android:text="APPLY 3D CAR SHAPE 🏎️"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</LinearLayout>
